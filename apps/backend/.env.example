# Core
ENVIRONMENT=dev
DEBUG=true
PROJECT_NAME=AquariumMonitor
PROJECT_DESCRIPTION=Open-source, self-hosted aquarium monitoring backend.
VERSION=0.1.0

# Storage
STORAGE_BACKEND=sqlite
DATABASE_URL=sqlite:///./data/app.db

# MariaDB (optional)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=aquarium
DB_USER=aquarium_app
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=root-change-me

# Auth & security
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
JWT_EXPIRES_SECONDS=3600
DEVICE_API_KEY_PEPPER=change-me
DEMO_ENABLED=true
DEMO_USERNAME=demo
DEMO_PASSWORD=demo
DEMO_USER_ID=00000000-0000-0000-0000-000000000001
SINGLE_OWNER_MODE=false
OWNER_EMAIL=
OWNER_USER_ID=

# Logging
LOG_LEVEL=INFO
LOG_JSON=false

# CORS
CORS_ORIGINS=*
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*

# Rate limiting (optional)
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

# SQLite durability
SQLITE_JOURNAL_MODE=WAL
SQLITE_SYNCHRONOUS=FULL
SQLITE_BUSY_TIMEOUT_MS=5000

# Backups
BACKUP_ENABLED=true
BACKUP_DIR=backups
BACKUP_RETENTION_DAYS=7
BACKUP_INTERVAL_HOURS=6

# Simulator queue (optional)
SIM_QUEUE_PATH=data/sim_queue.jsonl
SIM_PH4_VOLTAGE=3.0
SIM_PH7_VOLTAGE=2.5
SIM_PH9_VOLTAGE=2.0

# Seeding (optional)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
